# VELCARCARE CRM — Frontend environment variables
# Copy to .env and fill in. Only VITE_* vars reach the browser bundle.

VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_LOGO_DEV_KEY=your_logo_dev_publishable_key

# CarImagesAPI key for car-model images is set in index.html (client-side loader
# script), not as an env variable.
